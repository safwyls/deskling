{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskling",
  "version": "1.0.0",
  "identifier": "app.deskling.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Deskling",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "category": "Utility",
    "shortDescription": "Your Deskling companion on the desktop",
    "longDescription": "Your Deskling companion on the desktop: it sits on your screen, reminds you to drink water, rest your eyes, stretch and move, and travels between your dial, phone and computers.",
    "publisher": "safwyls",
    "copyright": "Copyright (c) 2026 safwyls. MIT licence.",
    "homepage": "https://safwyls.github.io/deskling/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["deskling"] }
    }
  }
}
