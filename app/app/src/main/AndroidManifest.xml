<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Bluetooth: finding and talking to the dial (never used for location) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- steps -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the glow around the screen's edge with a reminder (notify/EdgeFlash.kt) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the Bluetooth link held open to the dial for instant sync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:name=".DesklingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_wisp"
        android:label="Deskling"
        android:theme="@style/Theme.Deskling"
        android:usesCleartextTraffic="true">
        <!-- cleartext: the dial speaks plain HTTP on the local network -->

        <!-- the home screen widget (ui/Widget.kt), and what goes behind it -->
        <receiver android:name=".ui.CompanionWidget" android:exported="true" android:label="Deskling">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_companion" />
        </receiver>
        <activity android:name=".ui.WidgetSetup" android:exported="true" android:label="Deskling widget"
            android:theme="@style/Theme.Deskling">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".Home" android:exported="true" android:windowSoftInputMode="adjustResize" android:launchMode="singleTask">
            <!-- a companion shared from another phone: the website's "Open in the app" hands it over as deskling://companion?r=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deskling" android:host="companion" />
            </intent-filter>
        </activity>

        <!-- One launcher entry per companion, so the app icon can follow the pet (ui/LauncherIcon.kt switches them).
             Wisp's keeps the old ".MainActivity" name, so home-screen shortcuts from earlier versions still work. -->
        <activity-alias android:name=".MainActivity" android:targetActivity=".Home" android:exported="true"
            android:enabled="true" android:icon="@mipmap/ic_launcher_wisp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherCrumb" android:targetActivity=".Home" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_crumb">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSprig" android:targetActivity=".Home" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_sprig">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service android:name=".sync.LinkService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".notify.AlarmReceiver" android:exported="false" />
        <receiver android:name=".notify.DoneReceiver" android:exported="false" />
        <receiver android:name=".notify.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
